import asyncio
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command
from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton, WebAppInfo

# Токен бота
BOT_TOKEN = "8888816541:AAHr3KYdyGi3au_9xQQ83p7NVvI9A1Yp_xE"

# Ссылка на твой работающий сервер Render
WEB_APP_URL = "https://genkart-app.onrender.com"

bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()

@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="📄 Создать документ", web_app=WebAppInfo(url=WEB_APP_URL))]
    ])
    
    await message.answer(
        f"Привет, {message.from_user.first_name}!\n\n"
        "Я помогу тебе создать КП, Смету, Счет или Акт за 1 минуту.\n"
        "Нажми на кнопку ниже, чтобы открыть приложение.\n\n"
        "⏳ (Первый запуск может занять до 50 секунд, пока сервер просыпается)",
        reply_markup=keyboard
    )

async def main():
    print("Бот запущен и ждет сообщений...")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
